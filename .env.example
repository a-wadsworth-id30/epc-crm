DATABASE_URL="postgresql://crm:crm_password@localhost:5433/id30_crm_live?schema=public"
SESSION_COOKIE_NAME="id30_crm_session"
SESSION_TTL_DAYS="7"
NEXT_PUBLIC_APP_NAME="iD30 CRM"
APP_BASE_URL="http://localhost:3001"
APP_BUILD_COMMIT=""
APP_BUILD_BRANCH=""
APP_BUILD_TIME=""
CSP_ENFORCE="false"
CSP_ALLOW_UNSAFE_EVAL="false"

# Optional performance diagnostics. Leave disabled unless profiling.
PERFORMANCE_LOGGING_ENABLED="false"
PERFORMANCE_LOGGING_THRESHOLD_MS="400"
NEXT_PUBLIC_PERFORMANCE_WEB_VITALS_ENABLED="false"
PERFORMANCE_WEB_VITALS_LOGGING_ENABLED="false"

# Local seed credentials. Use a unique strong password for remote/production databases.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeThisLocalPassword123!"
SEED_ADMIN_NAME="Default Admin"

# Required for encrypted integration credentials and profile 2FA secrets.
# Generate before running preflight with: openssl rand -base64 32
# Leave blank only until you are ready to run npm run env:check.
CREDENTIAL_ENCRYPTION_KEY=""

# iD30 Auth broker fallback.
# Client installs can save these from Settings > Integrations > iD30 Auth instead.
ID30_AUTH_BASE_URL="https://auth.id30.com"
ID30_AUTH_CRM_CLIENT_ID="id30-crm-production"
ID30_AUTH_WORKSPACE_ID="id30-crm-production"
ID30_AUTH_SHARED_SECRET=""

# Signed read-only requests from mcp.id30.com.
MCP_CRM_SHARED_SECRET=""

# Advanced direct CRM provider fallback credentials.
# Normal client setup should use iD30 Auth for provider OAuth instead.
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=""
GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=""
MICROSOFT_ADS_OAUTH_CLIENT_ID=""
MICROSOFT_ADS_OAUTH_CLIENT_SECRET=""
MICROSOFT_ADS_DEVELOPER_TOKEN=""
META_ADS_OAUTH_CLIENT_ID=""
META_ADS_OAUTH_CLIENT_SECRET=""
LINKEDIN_ADS_OAUTH_CLIENT_ID=""
LINKEDIN_ADS_OAUTH_CLIENT_SECRET=""

# Optional provider API version pins. Leave blank to use these app defaults.
GOOGLE_ADS_API_VERSION="v24"
KLAVIYO_API_REVISION="2026-07-15"
LINKEDIN_MARKETING_API_VERSION="202607"
META_GRAPH_API_VERSION="v23.0"

# Shared secret for POST /api/marketing/conversion-uploads/process.
# Send as Authorization: Bearer <secret> or x-cron-secret.
MARKETING_UPLOAD_CRON_SECRET=""

# Public desktop softphone download folder. GitHub Actions publishes installers here.
ID30_SOFTPHONE_DOWNLOAD_BASE_URL=""
