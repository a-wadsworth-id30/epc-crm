# Runtime database connection. On Netlify this can be the Neon pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional Prisma pool overrides. For Neon pooled URLs, the app defaults to
# connection_limit=1 and pool_timeout=10 when these are omitted.
PRISMA_CONNECTION_LIMIT="1"
PRISMA_POOL_TIMEOUT="10"

# Optional but recommended on Netlify: direct Neon connection used only by the
# build migration step. If omitted, migrations use DATABASE_URL.
MIGRATE_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require"
APP_BASE_URL="https://crm.epc.example"
NEXT_PUBLIC_APP_NAME="EPC CRM"
APP_BUILD_COMMIT=""
APP_BUILD_BRANCH=""
APP_BUILD_TIME=""

# Optional performance diagnostics. Leave disabled unless profiling.
PERFORMANCE_LOGGING_ENABLED="false"
PERFORMANCE_LOGGING_THRESHOLD_MS="400"
NEXT_PUBLIC_PERFORMANCE_WEB_VITALS_ENABLED="false"
PERFORMANCE_WEB_VITALS_LOGGING_ENABLED="false"

SESSION_COOKIE_NAME="epc_crm_session"
SESSION_TTL_DAYS="7"

# Seed credentials. Only use for first production bootstrap.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-strong-password"
SEED_ADMIN_NAME="Default Admin"

# Required before saving encrypted integration credentials or enabling 2FA.
# Generate with `openssl rand -base64 32`; the placeholder below fails preflight.
CREDENTIAL_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# Signed read-only requests from mcp.id30.com.
# Must match MCP_CRM_SHARED_SECRET in the mcp.id30.com Netlify app.
ID30_AUTH_BASE_URL="https://auth.id30.com"
ID30_AUTH_CRM_CLIENT_ID="epc-crm-production"
ID30_AUTH_WORKSPACE_ID="epc-crm-production"
MCP_CRM_SHARED_SECRET=""

# Marketing provider OAuth apps and shared API credentials.
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=""
GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=""
MICROSOFT_ADS_OAUTH_CLIENT_ID=""
MICROSOFT_ADS_OAUTH_CLIENT_SECRET=""
MICROSOFT_ADS_DEVELOPER_TOKEN=""
META_ADS_OAUTH_CLIENT_ID=""
META_ADS_OAUTH_CLIENT_SECRET=""
LINKEDIN_ADS_OAUTH_CLIENT_ID=""
LINKEDIN_ADS_OAUTH_CLIENT_SECRET=""

# Optional provider API version pins. Leave blank to use these app defaults.
GOOGLE_ADS_API_VERSION="v24"
KLAVIYO_API_REVISION="2026-07-15"
LINKEDIN_MARKETING_API_VERSION="202607"
META_GRAPH_API_VERSION="v23.0"

# Public desktop softphone download folder. GitHub Actions publishes installers here.
ID30_SOFTPHONE_DOWNLOAD_BASE_URL="https://downloads.example.com/desktop-softphone"
