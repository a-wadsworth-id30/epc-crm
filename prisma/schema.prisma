  @@index([createdByUserId, createdAt])
}

model SignatureRequest {
  id                     String                 @id @default(cuid())
  provider               String                 @default("docusign")
  providerEnvelopeId     String?                @unique
  providerStatus         String?
  entityType             String
  entityId               String
  sourceFileAssetId      String
  sourceFileAsset        FileAsset              @relation("SignatureRequestSourceFile", fields: [sourceFileAssetId], references: [id], onDelete: Restrict)
  signedFileAssetId      String?
  signedFileAsset        FileAsset?             @relation("SignatureRequestSignedFile", fields: [signedFileAssetId], references: [id], onDelete: SetNull)
  certificateFileAssetId String?
  certificateFileAsset   FileAsset?             @relation("SignatureRequestCertificateFile", fields: [certificateFileAssetId], references: [id], onDelete: SetNull)
  subject                String
  message                String?
  status                 SignatureRequestStatus @default(DRAFT)
  sentAt                 DateTime?
  deliveredAt            DateTime?
  completedAt            DateTime?
  declinedAt             DateTime?
  voidedAt               DateTime?
  lastEventAt            DateTime?
  errorMessage           String?
  createdByUserId        String?
  createdByUser          User?                  @relation("SignatureRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients             SignatureRecipient[]
  events                 SignatureEvent[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([entityType, entityId, createdAt])
  @@index([status, createdAt])
  @@index([sourceFileAssetId, createdAt])
  @@index([signedFileAssetId])
  @@index([certificateFileAssetId])
  @@index([createdByUserId, createdAt])
}

model SignatureRecipient {
  id                  String                   @id @default(cuid())
  requestId           String
  request             SignatureRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name                String
  email               String
  roleName            String                   @default("Customer")
  routingOrder        Int                      @default(1)
  providerRecipientId String?
  status              SignatureRecipientStatus @default(CREATED)
  deliveredAt         DateTime?
  signedAt            DateTime?
  declinedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([requestId, routingOrder])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

model SignatureEvent {
  id             String           @id @default(cuid())
  requestId      String
  request        SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider       String           @default("docusign")
  eventType      String
  providerStatus String?
  occurredAt     DateTime?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([requestId, createdAt])
  @@index([eventType, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([updatedAt])
  @@index([createdAt])
  @@index([status, updatedAt])
  @@index([status, dueDate, updatedAt])
  @@index([assigneeId, updatedAt])
  @@index([companyId, updatedAt])
  @@index([contactId, updatedAt])
}

model IntegrationConnection {
  id                  String                        @id @default(cuid())
  provider            String                        @unique
  name                String
  description         String
  status              IntegrationStatus             @default(NOT_CONNECTED)
  config              Json?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  externalRecordLinks ExternalRecordLink[]
  healthSnapshots     IntegrationHealthSnapshot[]
  marketingSyncLogs   MarketingIntegrationSyncLog[]
}

model ExternalRecordLink {
  id            String                 @id @default(cuid())
  provider      String
  externalType  String
  externalId    String
  internalType  String
  internalId    String
  integrationId String?
  integration   IntegrationConnection? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  lastSeenAt    DateTime?
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([provider, externalType, externalId])
  @@index([provider, internalType, internalId])
  @@index([integrationId, updatedAt])
  @@index([provider, updatedAt])
}

model IntegrationHealthSnapshot {
  id            String                          @id @default(cuid())
  integrationId String?
  integration   IntegrationConnection?          @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider      String
  capability    String
  status        IntegrationHealthSnapshotStatus @default(UNKNOWN)
  source        String                          @default("manual")
  message       String?
  metadata      Json?
  checkedAt     DateTime                        @default(now())
  createdAt     DateTime                        @default(now())

  @@index([provider, checkedAt])
  @@index([integrationId, checkedAt])
  @@index([status, checkedAt])
  @@index([capability, checkedAt])
}

model BackgroundJobRun {
  id             String                 @id @default(cuid())
  jobType        String
  jobName        String
  status         BackgroundJobRunStatus @default(RUNNING)
  trigger        String                 @default("manual")
  dryRun         Boolean                @default(false)
  actorId        String?
  actor          User?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  recordsRead    Int                    @default(0)
  recordsWritten Int                    @default(0)
  message        String?
  errorMessage   String?
  summary        Json?
  metadata       Json?
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, startedAt])
  @@index([jobType, startedAt])
  @@index([jobName, startedAt])
  @@index([actorId, startedAt])
  @@index([createdAt])
}

model MarketingIntegrationSyncLog {
  id             String                         @id @default(cuid())
  integrationId  String
  integration    IntegrationConnection          @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider       String
  status         MarketingIntegrationSyncStatus
  syncType       String
  recordsRead    Int                            @default(0)
  recordsWritten Int                            @default(0)
  message        String?
  metadata       Json?
  startedAt      DateTime                       @default(now())
  finishedAt     DateTime?
  createdAt      DateTime                       @default(now())

  @@index([provider, startedAt])
  @@index([integrationId, startedAt])
  @@index([createdAt])
}

model MarketingConversionUpload {
  id             String                          @id @default(cuid())
  provider       String
  conversionType String
  entityType     String
  entityId       String
  status         MarketingConversionUploadStatus @default(PENDING)
  valueCents     Int?
  currency       String                          @default("GBP")
  occurredAt     DateTime
  clickId        String?
  clickIdSource  String?
  conversionName String?
  payload        Json?
  response       Json?
  message        String?
  attemptCount   Int                             @default(0)
  lastAttemptAt  DateTime?
  uploadedAt     DateTime?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@unique([provider, conversionType, entityType, entityId])
  @@index([provider, status, occurredAt])
  @@index([status, updatedAt])
  @@index([entityType, entityId])
  @@index([occurredAt])
}

model MarketingCampaignSpend {
  id           String   @id @default(cuid())
  provider     String
  accountId    String
  campaignId   String
  campaignName String?
  date         DateTime
  currency     String   @default("GBP")
  costMicros   BigInt   @default(0)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  conversions  Float    @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, accountId, campaignId, date])
  @@index([provider, date])
  @@index([campaignId, date])
}

model MarketingDailyRollup {
  id                 String   @id @default(cuid())
  date               DateTime
  source             String   @default("ALL")
  provider           String   @default("ALL")
  currency           String   @default("GBP")
  sessions           Int      @default(0)
  attributionRecords Int      @default(0)
  formLeads          Int      @default(0)
  phoneLeads         Int      @default(0)
  otherLeads         Int      @default(0)
  clicks             Int      @default(0)
  impressions        Int      @default(0)
  conversions        Float    @default(0)
  costMicros         BigInt   @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([date, source, provider])
  @@index([date])
  @@index([source, date])
  @@index([provider, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
}

model McpRequestNonce {
  id          String   @id @default(cuid())
  requestId   String
  crmClientId String
  workspaceId String
  subject     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([workspaceId, requestId])
  @@index([crmClientId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([expiresAt])
}

model RealtimeVersion {
  id        String   @id @default(cuid())
  topic     String   @unique
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}
