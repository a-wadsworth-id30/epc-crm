generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ContactSegmentAudience {
  PEOPLE
  COMPANIES
}

enum ContactCategory {
  CONSUMER
  TRADE
  INSTALLER
  COMPANY
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  ERROR
}

enum IntegrationHealthSnapshotStatus {
  READY
  WARNING
  ERROR
  UNKNOWN
}

enum MarketingIntegrationSyncStatus {
  SUCCESS
  WARNING
  ERROR
}

enum MarketingConversionUploadStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum BackgroundJobRunStatus {
  RUNNING
  SUCCESS
  WARNING
  ERROR
}

enum SalesStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum SalesLifecycleEventType {
  CREATED
  STAGE_CHANGED
  CONTACTED
  LOST_REASON_UPDATED
}

enum StageMovementPolicy {
  MANUAL
  AI_SUGGESTED
  RULE_AUTOMATED
  AI_AUTOMATED
}

enum StageGateMode {
  NONE
  WARN
  BLOCK
}

enum SalesAutomationTriggerType {
  STAGE_ENTERED
  EMAIL_RECEIVED
  EMAIL_SENT
  SMS_RECEIVED
  SMS_SENT
  CALL_COMPLETED
  CALL_MISSED
  SITE_VISIT
}

enum SalesAutomationActionType {
  CREATE_TASK
  SEND_EMAIL
  SEND_SMS
  NOTIFY_OWNER
  UPDATE_SCORE
  SUGGEST_STAGE_MOVE
}

enum SalesAutomationRunStatus {
  COMPLETED
  SKIPPED
  FAILED
}

enum CommunicationChannel {
  PHONE
  EMAIL
  SMS
  WHATSAPP
  NOTE
  SYSTEM
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum EmailMessageStatus {
  UNREAD
  READ
  ARCHIVED
}

enum VoiceRoutingMode {
  BROWSER
  MOBILE
  LANDLINE
  SIP
  FLEX
}

enum AgentAvailability {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

enum CallDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
  CANCELED
}

enum CallQueueStatus {
  WAITING
  CONNECTING
  ANSWERED
  MISSED
  ABANDONED
  COMPLETED
}

enum RecordingConsentStatus {
  NOT_REQUIRED
  PENDING
  CONSENTED
  DECLINED
}

enum BusinessPhoneNumberStatus {
  ACTIVE
  RELEASED
}

enum FileAssetVisibility {
  PRIVATE
  PUBLIC
}

enum CustomerUploadRequestStatus {
  OPEN
  COMPLETED
  REVOKED
}

enum CustomerDocumentShareStatus {
  OPEN
  REVOKED
}

enum CustomerDocumentPortalStatus {
  OPEN
  REVOKED
}

enum SignatureRequestStatus {
  DRAFT
  SENT
  DELIVERED
  COMPLETED
  DECLINED
  VOIDED
  EXPIRED
  ERROR
}

enum SignatureRecipientStatus {
  CREATED
  SENT
  DELIVERED
  COMPLETED
  DECLINED
  AUTHENTICATION_FAILED
  AUTO_RESPONDED
}

enum AttributionRecordSource {
  FORM
  PHONE
  MANUAL
}

enum AttributionTouchpointRole {
  FIRST
  ASSISTED
  LAST
  FIRST_LAST
}

enum OfflineCampaignChannel {
  RADIO
  PRINT
  EVENT
  DIRECT_MAIL
  QR
  OUTDOOR
  TV
  PARTNERSHIP
  REFERRAL
  OTHER
}

enum OfflineCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProductRecordType {
  SERVICE
  PHYSICAL
  DIGITAL
  SUBSCRIPTION
  BUNDLE
}

enum ProductCategoryCollectionMode {
  MANUAL
  AUTOMATED
}

enum ProductCategoryRuleMatch {
  ANY
  ALL
}

enum OpportunityProductStatus {
  SUSPECTED
  CONFIRMED
  QUOTED
  DECLINED
}

enum DiscoveryTemplateScope {
  LEAD
  PRODUCT
  CATEGORY
}

enum DiscoveryQuestionScope {
  OPPORTUNITY
  PRODUCT
  CATEGORY
  LINE_ITEM
}

enum DiscoveryAnswerType {
  TEXT
  LONG_TEXT
  URL
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  PRODUCT_SELECT
  PRODUCT_MULTI_SELECT
  CATEGORY_SELECT
  CATEGORY_MULTI_SELECT
  NUMBER
  DATE
  DATETIME
  CURRENCY
  CURRENCY_RANGE
  DOMAIN
  SLIDER
}

enum DiscoveryAnswerMode {
  SINGLE
  MULTIPLE_MAX
  MULTIPLE_UNLIMITED
}

enum DiscoveryAnswerSource {
  MANUAL
  AI
  FORM
  IMPORT
}

enum SidekickWritePlanStatus {
  DRAFT
  APPROVED
  APPLIED
  REJECTED
  FAILED
}

model User {
  id                         String                       @id @default(cuid())
  name                       String
  firstName                  String?
  lastName                   String?
  avatarUrl                  String?
  landline                   String?
  mobile                     String?
  voiceRoutingMode           VoiceRoutingMode             @default(BROWSER)
  voiceExtension             String?
  sipAddress                 String?
  voiceAvailability          AgentAvailability            @default(OFFLINE)
  voiceLastSeenAt            DateTime?
  desktopSoftphoneLastSeenAt DateTime?
  desktopSoftphoneCommand    Json?
  twoFactorEnabled           Boolean                      @default(false)
  twoFactorSecret            String?
  twoFactorEnabledAt         DateTime?
  twoFactorLastVerifiedAt    DateTime?
  email                      String                       @unique
  passwordHash               String
  role                       UserRole                     @default(USER)
  roleTemplate               String?
  status                     UserStatus                   @default(ACTIVE)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  sessions                   Session[]
  notes                      Note[]
  assignedTasks              Task[]                       @relation("TaskAssignee")
  createdTasks               Task[]                       @relation("TaskCreator")
  ownedOpportunities         SalesOpportunity[]           @relation("OpportunityOwner")
  salesCommunications        SalesCommunication[]
  callLogs                   CallLog[]
  queuedCalls                CallQueueEntry[]             @relation("QueuedCallAssignee")
  uploadedFiles              FileAsset[]                  @relation("FileUploader")
  passwordResetTokens        PasswordResetToken[]
  salesLifecycleEvents       SalesLifecycleEvent[]        @relation("SalesLifecycleEventUser")
  discoveryAnswers           OpportunityDiscoveryAnswer[] @relation("DiscoveryAnswerUser")
  createdOfflineCampaigns    OfflineCampaign[]            @relation("OfflineCampaignCreator")
  reportDefinitions          ReportDefinition[]
  reportRuns                 ReportRun[]
  auditLogs                  AuditLog[]
  createdSidekickWritePlans  SidekickWritePlan[]          @relation("SidekickWritePlanCreator")
  approvedSidekickWritePlans SidekickWritePlan[]          @relation("SidekickWritePlanApprover")
  createdCompanies           Company[]                    @relation("CompanyCreator")
  createdContacts            Contact[]                    @relation("ContactCreator")
  createdContactSegments     ContactSegment[]             @relation("ContactSegmentCreator")
  createdUploadRequests      CustomerUploadRequest[]      @relation("CustomerUploadRequestCreator")
  createdDocumentShares      CustomerDocumentShare[]      @relation("CustomerDocumentShareCreator")
  createdDocumentPortals     CustomerDocumentPortal[]     @relation("CustomerDocumentPortalCreator")
  createdSignatureRequests   SignatureRequest[]           @relation("SignatureRequestCreator")
  notificationStates         NotificationState[]
  backgroundJobRuns          BackgroundJobRun[]

  @@index([roleTemplate])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@index([userId, lastSeenAt, createdAt])
}

model AuthRateLimitBucket {
  id              String    @id @default(cuid())
  key             String    @unique
  attempts        Int       @default(0)
  blockedUntil    DateTime?
  windowStartedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model NotificationState {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  fingerprint    String
  seenAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, notificationId])
  @@index([userId, seenAt])
  @@index([userId, dismissedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([createdAt])
}

model Company {
  id              String             @id @default(cuid())
  name            String
  domain          String?
  status          String             @default("Prospect")
  owner           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  county          String?
  postcode        String?
  country         String?
  createdByUserId String?
  createdByUser   User?              @relation("CompanyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  contacts        Contact[]
  notes           Note[]
  tasks           Task[]
  opportunities   SalesOpportunity[]

  @@index([updatedAt])
  @@index([name])
  @@index([createdByUserId, updatedAt])
}

model Contact {
  id                    String                 @id @default(cuid())
  firstName             String
  lastName              String
  category              ContactCategory        @default(CONSUMER)
  email                 String?
  phone                 String?
  phoneNormalized       String?
  additionalEmails      ContactEmailAddress[]
  additionalPhones      ContactPhoneNumber[]
  leadSource            String?
  role                  String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  county                String?
  postcode              String?
  country               String?
  companyId             String?
  companyName           String?
  company               Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes                 Note[]
  tasks                 Task[]
  opportunities         SalesOpportunity[]
  salesCommunications   SalesCommunication[]
  emailMessages         EmailMessage[]
  callLogs              CallLog[]
  queueEntries          CallQueueEntry[]
  tagAssignments        ContactTagAssignment[]
  attribution           Json?
  aiGuidance            Json?
  aiGuidanceFingerprint String?
  aiGuidanceGeneratedAt DateTime?
  createdByUserId       String?
  createdByUser         User?                  @relation("ContactCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([updatedAt])
  @@index([createdAt])
  @@index([category, updatedAt])
  @@index([lastName, firstName])
  @@index([leadSource, createdAt])
  @@index([phoneNormalized])
  @@index([companyId, updatedAt])
  @@index([createdByUserId, updatedAt])
}

model ContactEmailAddress {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String?
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, email])
  @@index([contactId])
  @@index([email])
}

model ContactPhoneNumber {
  id              String   @id @default(cuid())
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label           String?
  phone           String
  phoneNormalized String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([contactId, phone])
  @@index([contactId])
  @@index([phoneNormalized])
}

model ContactTag {
  id          String                 @id @default(cuid())
  name        String
  slug        String                 @unique
  assignments ContactTagAssignment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model ContactTagAssignment {
  contactId String
  tagId     String
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
}

model ContactSegment {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  audience        ContactSegmentAudience @default(PEOPLE)
  prompt          String?
  criteria        Json
  aiSummary       String?
  matchCount      Int                    @default(0)
  lastEvaluatedAt DateTime?
  createdByUserId String?
  createdByUser   User?                  @relation("ContactSegmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([audience, updatedAt])
  @@index([createdByUserId, updatedAt])
}

model SalesOpportunity {
  id                    String                       @id @default(cuid())
  title                 String
  stage                 SalesStage                   @default(LEAD)
  salesPipelineStageId  String?
  salesPipelineStage    SalesPipelineStage?          @relation(fields: [salesPipelineStageId], references: [id], onDelete: SetNull)
  valueCents            Int                          @default(0)
  currency              String                       @default("GBP")
  probability           Int                          @default(10)
  source                String?
  nextStep              String?
  expectedCloseDate     DateTime?
  ownerId               String?
  owner                 User?                        @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  companyId             String?
  company               Company?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId             String?
  contact               Contact?                     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  communications        SalesCommunication[]
  emailMessages         EmailMessage[]
  lifecycleEvents       SalesLifecycleEvent[]
  products              OpportunityProduct[]
  discoveryAnswers      OpportunityDiscoveryAnswer[]
  scoreEvents           LeadScoreEvent[]
  automationRuns        SalesAutomationRun[]
  callLogs              CallLog[]
  queueEntries          CallQueueEntry[]
  attribution           Json?
  leadScope             Json?
  score                 Int                          @default(0)
  scoreUpdatedAt        DateTime?
  aiGuidance            Json?
  aiGuidanceFingerprint String?
  aiGuidanceGeneratedAt DateTime?
  firstContactedAt      DateTime?
  stageChangedAt        DateTime                     @default(now())
  closedAt              DateTime?
  lostReason            String?
  lostReasonNotes       String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([stage])
  @@index([salesPipelineStageId])
  @@index([expectedCloseDate])
  @@index([stageChangedAt])
  @@index([closedAt])
  @@index([firstContactedAt])
  @@index([lostReason])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([score])
  @@index([stage, updatedAt])
  @@index([source, createdAt])
  @@index([ownerId, createdAt])
  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
}

model ProductCategory {
  id             String                        @id @default(cuid())
  name           String
  slug           String                        @unique
  parentId       String?
  parent         ProductCategory?              @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[]             @relation("ProductCategoryTree")
  description    String?
  collectionMode ProductCategoryCollectionMode @default(MANUAL)
  ruleMatch      ProductCategoryRuleMatch      @default(ANY)
  ruleTags       String[]                      @default([])
  ruleConditions Json?
  isActive       Boolean                       @default(true)
  sortOrder      Int                           @default(0)
  metadata       Json?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  products           Product[]
  manualProducts     ProductCategoryProduct[]
  discoveryTemplates ProductCategoryDiscoveryTemplate[]
  discoveryAnswers   OpportunityDiscoveryAnswer[]

  @@index([isActive, sortOrder])
  @@index([parentId])
  @@index([collectionMode])
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  type             ProductRecordType @default(SERVICE)
  categoryId       String?
  category         ProductCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageFileAssetId String?
  imageFileAsset   FileAsset?        @relation("ProductImageAsset", fields: [imageFileAssetId], references: [id], onDelete: SetNull)
  sku              String?
  description      String?
  tags             String[]          @default([])
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  categoryAssignments ProductCategoryProduct[]
  discoveryTemplates  ProductDiscoveryTemplate[]
  opportunityProducts OpportunityProduct[]
  discoveryAnswers    OpportunityDiscoveryAnswer[]

  @@index([isActive, sortOrder])
  @@index([categoryId])
  @@index([imageFileAssetId])
  @@index([type])
  @@index([sku])
}

model ProductCategoryProduct {
  id         String          @id @default(cuid())
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())

  @@unique([categoryId, productId])
  @@index([productId])
  @@index([categoryId, sortOrder])
}

model DiscoveryTemplate {
  id                   String                 @id @default(cuid())
  name                 String
  slug                 String                 @unique
  scope                DiscoveryTemplateScope @default(LEAD)
  version              Int                    @default(1)
  description          String?
  salesPipelineStageId String?
  salesPipelineStage   SalesPipelineStage?    @relation(fields: [salesPipelineStageId], references: [id], onDelete: SetNull)
  isActive             Boolean                @default(true)
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  questions  DiscoveryTemplateQuestion[]
  products   ProductDiscoveryTemplate[]
  categories ProductCategoryDiscoveryTemplate[]

  @@index([scope, isActive])
  @@index([salesPipelineStageId])
}

model DiscoveryQuestion {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  label            String
  helpText         String?
  scope            DiscoveryQuestionScope @default(OPPORTUNITY)
  answerType       DiscoveryAnswerType    @default(TEXT)
  answerMode       DiscoveryAnswerMode    @default(SINGLE)
  version          Int                    @default(1)
  supersededById   String?
  supersededBy     DiscoveryQuestion?     @relation("DiscoveryQuestionVersions", fields: [supersededById], references: [id], onDelete: SetNull)
  previousVersions DiscoveryQuestion[]    @relation("DiscoveryQuestionVersions")
  maxAnswers       Int?
  options          Json?
  defaultRequired  Boolean                @default(false)
  dedupeKey        String?
  isActive         Boolean                @default(true)
  archivedAt       DateTime?
  sortOrder        Int                    @default(0)
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  templates DiscoveryTemplateQuestion[]
  answers   OpportunityDiscoveryAnswer[]

  @@index([scope, isActive])
  @@index([dedupeKey])
  @@index([supersededById])
  @@index([archivedAt])
  @@index([sortOrder])
}

model DiscoveryTemplateQuestion {
  id               String            @id @default(cuid())
  templateId       String
  template         DiscoveryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questionId       String
  question         DiscoveryQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder        Int               @default(0)
  required         Boolean           @default(false)
  requirementLevel String            @default("standard")
  visibilityRules  Json?
  requirementRules Json?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([templateId, questionId])
  @@index([questionId])
  @@index([templateId, sortOrder])
}

model ProductDiscoveryTemplate {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateId String
  template   DiscoveryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([productId, templateId])
  @@index([templateId])
}

model ProductCategoryDiscoveryTemplate {
  id         String            @id @default(cuid())
  categoryId String
  category   ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  templateId String
  template   DiscoveryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([categoryId, templateId])
  @@index([templateId])
}

model OpportunityProduct {
  id                  String                   @id @default(cuid())
  opportunityId       String
  opportunity         SalesOpportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId           String
  product             Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  status              OpportunityProductStatus @default(SUSPECTED)
  quantity            Int                      @default(1)
  estimatedValueCents Int?
  source              String?
  confidence          Int?
  notes               String?
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([opportunityId, productId])
  @@index([productId, status])
  @@index([opportunityId, status])
}

model OpportunityDiscoveryAnswer {
  id                         String                @id @default(cuid())
  opportunityId              String
  opportunity                SalesOpportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  questionId                 String
  question                   DiscoveryQuestion     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  productId                  String?
  product                    Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId                 String?
  category                   ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  value                      Json?
  questionLabelSnapshot      String?
  questionHelpTextSnapshot   String?
  questionAnswerTypeSnapshot String?
  questionAnswerModeSnapshot String?
  questionVersionSnapshot    Int?
  questionOptionsSnapshot    Json?
  source                     DiscoveryAnswerSource @default(MANUAL)
  confidence                 Int?
  answeredAt                 DateTime?
  confirmedAt                DateTime?
  answeredByUserId           String?
  answeredByUser             User?                 @relation("DiscoveryAnswerUser", fields: [answeredByUserId], references: [id], onDelete: SetNull)
  metadata                   Json?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  @@index([opportunityId, questionId])
  @@index([productId, questionId])
  @@index([categoryId, questionId])
  @@index([answeredByUserId, answeredAt])
}

model SidekickWritePlan {
  id               String                  @id @default(cuid())
  type             String                  @default("DISCOVERY_PACK")
  prompt           String
  summary          String
  status           SidekickWritePlanStatus @default(DRAFT)
  plan             Json
  createdByUserId  String?
  createdByUser    User?                   @relation("SidekickWritePlanCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUserId String?
  approvedByUser   User?                   @relation("SidekickWritePlanApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  appliedAt        DateTime?
  rejectedAt       DateTime?
  failureMessage   String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([type, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([approvedByUserId, approvedAt])
}

model SalesLifecycleEvent {
  id                  String                  @id @default(cuid())
  opportunityId       String
  opportunity         SalesOpportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  eventType           SalesLifecycleEventType @default(STAGE_CHANGED)
  fromStage           SalesStage?
  toStage             SalesStage?
  fromPipelineStageId String?
  fromPipelineStage   SalesPipelineStage?     @relation("SalesLifecycleEventFromPipelineStage", fields: [fromPipelineStageId], references: [id], onDelete: SetNull)
  toPipelineStageId   String?
  toPipelineStage     SalesPipelineStage?     @relation("SalesLifecycleEventToPipelineStage", fields: [toPipelineStageId], references: [id], onDelete: SetNull)
  lostReason          String?
  note                String?
  occurredAt          DateTime                @default(now())
  userId              String?
  user                User?                   @relation("SalesLifecycleEventUser", fields: [userId], references: [id], onDelete: SetNull)
  metadata            Json?
  createdAt           DateTime                @default(now())

  @@index([opportunityId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([toStage, occurredAt])
  @@index([toPipelineStageId, occurredAt])
  @@index([fromPipelineStageId])
  @@index([userId, occurredAt])
  @@index([lostReason])
}

model SalesPipelineStage {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  bucket             SalesStage
  sortOrder          Int
  defaultProbability Int
  goal               String?
  aiContext          String?
