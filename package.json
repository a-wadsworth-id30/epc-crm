{
  "name": "id30-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3001",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:attribution-sale": "tsx scripts/seed-attribution-sale.ts",
    "e2e:prepare": "tsx scripts/prepare-e2e-tenant.ts",
    "tasks:cleanup-missed-calls": "tsx scripts/maintenance/cleanup-missed-call-tasks.ts",
    "maintenance:docusign-dedupe": "tsx scripts/maintenance/cleanup-docusign-duplicate-documents.ts",
    "maintenance:docusign-dedupe:apply": "tsx scripts/maintenance/cleanup-docusign-duplicate-documents.ts --apply",
    "db:studio": "prisma studio",
    "build": "next build",
    "build:profile": "npm run build && npm run perf:bundle",
    "start": "next start",
    "hostinger:build": "npm run db:migrate:deploy && npm run build",
    "hostinger:start": "npm run start -- -p ${PORT:-3000}",
    "netlify:build": "tsx scripts/check-env.ts && prisma generate && node scripts/deploy-migrations.mjs && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "env:check": "tsx scripts/check-env.ts",
    "production:preflight": "tsx scripts/production-preflight.ts",
    "neon:advisor": "tsx scripts/neon-optimization-report.ts",
    "perf:bundle": "node scripts/performance/bundle-summary.mjs",
    "deploy:check": "tsx scripts/check-live-build.ts",
    "sidekick:prompt-smoke": "tsx scripts/sidekick-report-prompt-smoke.ts",
    "db:check": "tsx scripts/check-database.ts",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "verify:production": "npm run env:check && npm run production:preflight && npm run db:migrate:status && npm run verify",
    "test": "npm run lint && npm run test:unit && npm run test:pytest",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:pytest": "python3 -m pytest -q",
    "smoke:routes": "playwright test tests/smoke.spec.ts",
    "test:e2e:audit": "playwright test tests/e2e-audit.spec.ts",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "playwright": "playwright test",
    "docs:screenshots": "playwright test tests/docs-screenshots.spec.ts",
    "docs:generate": "npm run docs:screenshots"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@floating-ui/react": "^0.27.16",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.0.9",
    "@thesvg/react": "^3.0.19",
    "@twilio/voice-sdk": "^2.18.3",
    "@types/qrcode": "^1.5.6",
    "apexcharts": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lightningcss": "^1.30.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.9",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.30.2",
    "lightningcss-linux-x64-musl": "^1.30.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.19",
    "cypress": "^15.17.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.24",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^6.19.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.18.0",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
